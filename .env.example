# Application
APP_ENV=development
APP_NAME=vezilka-text-scraper

# Logging
LOG_LEVEL=INFO
LOG_COLOR=true
LOG_FORMAT=human
LOG_DEFAULT_COLOR=cyan

# MediaWiki API
MEDIAWIKI_API_URL=https://mk.wikipedia.org/w/api.php
MEDIAWIKI_USER_AGENT=VezilkaTextScraper/0.1.0 (contact@example.com)
MEDIAWIKI_REQUEST_TIMEOUT_SECONDS=30
MEDIAWIKI_MAX_RETRIES=3

# Corpus
LANGUAGE=mk

# Storage
SQLITE_DATABASE_PATH=data/vezilka_corpus.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vezilka
POSTGRES_PASSWORD=vezilka
POSTGRES_DATABASE=vezilka
POSTGRES_SCHEMA=public

# Output paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXPORT_DATA_DIR=data/exports
